<?xml version="1.0"?>
<sdf version="1.9">
  <!-- FLU body, 65 mm between opposite motor shafts. Masses include a 1S pack. -->
  <model name="whoop" canonical_link="body">
    <link name="body">
      <inertial>
        <mass>0.0256</mass>
        <inertia><ixx>0.0000082</ixx><iyy>0.0000086</iyy><izz>0.0000144</izz></inertia>
      </inertial>
      <velocity_decay><linear>0.09</linear><angular>0.04</angular></velocity_decay>
      <collision name="underside"><pose>0 0 -0.008 0 0 0</pose><geometry><box><size>0.044 0.017 0.012</size></box></geometry></collision>
      <visual name="battery">
        <visibility_flags>2</visibility_flags>
        <pose>0 0 -0.008 0 0 0</pose><geometry><box><size>0.044 0.017 0.012</size></box></geometry>
        <material><ambient>0.12 0.14 0.15 1</ambient><diffuse>0.12 0.14 0.15 1</diffuse></material>
      </visual>
      <visual name="flight_controller">
        <visibility_flags>2</visibility_flags>
        <pose>0 0 0.001 0 0 0</pose><geometry><box><size>0.034 0.034 0.004</size></box></geometry>
        <material><ambient>0.02 0.20 0.17 1</ambient><diffuse>0.02 0.20 0.17 1</diffuse></material>
      </visual>
      <visual name="camera_housing">
        <visibility_flags>2</visibility_flags>
        <pose>0.011 0 0.010 0 -0.698131701 0</pose><geometry><box><size>0.014 0.013 0.012</size></box></geometry>
        <material><ambient>0.07 0.09 0.10 1</ambient><diffuse>0.07 0.09 0.10 1</diffuse></material>
      </visual>
      <!-- The official Gazebo bridge reads sensor-frame acceleration and angular velocity. -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 3.14159265359 0 0</pose><always_on>true</always_on>
        <update_rate>1000</update_rate><topic>/whoop/imu</topic>
      </sensor>
      <!-- 1/3-inch CMOS, 2.1 mm M7. Virtual pinhole feeds the calibrated NTSC lens stage (sim/optics.py). -->
      <sensor name="fpv" type="camera">
        <pose>0.022 0 0.013 0 -0.698131701 0</pose>
        <always_on>true</always_on><update_rate>60</update_rate><topic>/whoop/camera</topic>
        <camera><visibility_mask>1</visibility_mask><horizontal_fov>2.7077123969</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.008</near><far>15</far></clip>
        </camera>
      </sensor>
      <collision name="rear_right_guard"><pose>-0.022981 -0.022981 0.003 0 0 0</pose><geometry><cylinder><radius>0.0176</radius><length>0.0055</length></cylinder></geometry></collision>
      <visual name="rear_right_duct">
        <visibility_flags>2</visibility_flags>
        <pose>-0.022981 -0.022981 0.003 0 0 0</pose><geometry><mesh><uri>model://whoop/duct.obj</uri></mesh></geometry>
        <material><ambient>0.12 0.44 0.65 1</ambient><diffuse>0.12 0.44 0.65 1</diffuse></material>
      </visual>
      <visual name="rear_right_motor">
        <visibility_flags>2</visibility_flags>
        <pose>-0.022981 -0.022981 0 0 0 0</pose><geometry><cylinder><radius>0.0035</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.12 0.13 0.15 1</ambient><diffuse>0.12 0.13 0.15 1</diffuse></material>
      </visual>
      <visual name="rear_right_arm">
        <visibility_flags>2</visibility_flags>
        <pose>-0.011491 -0.011491 0 0 0 0.785398</pose><geometry><box><size>0.0325 0.004 0.003</size></box></geometry>
        <material><ambient>0.12 0.44 0.65 1</ambient><diffuse>0.12 0.44 0.65 1</diffuse></material>
      </visual>
      <collision name="front_right_guard"><pose>0.022981 -0.022981 0.003 0 0 0</pose><geometry><cylinder><radius>0.0176</radius><length>0.0055</length></cylinder></geometry></collision>
      <visual name="front_right_duct">
        <visibility_flags>2</visibility_flags>
        <pose>0.022981 -0.022981 0.003 0 0 0</pose><geometry><mesh><uri>model://whoop/duct.obj</uri></mesh></geometry>
        <material><ambient>0.12 0.44 0.65 1</ambient><diffuse>0.12 0.44 0.65 1</diffuse></material>
      </visual>
      <visual name="front_right_motor">
        <visibility_flags>2</visibility_flags>
        <pose>0.022981 -0.022981 0 0 0 0</pose><geometry><cylinder><radius>0.0035</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.12 0.13 0.15 1</ambient><diffuse>0.12 0.13 0.15 1</diffuse></material>
      </visual>
      <visual name="front_right_arm">
        <visibility_flags>2</visibility_flags>
        <pose>0.011491 -0.011491 0 0 0 -0.785398</pose><geometry><box><size>0.0325 0.004 0.003</size></box></geometry>
        <material><ambient>0.12 0.44 0.65 1</ambient><diffuse>0.12 0.44 0.65 1</diffuse></material>
      </visual>
      <collision name="rear_left_guard"><pose>-0.022981 0.022981 0.003 0 0 0</pose><geometry><cylinder><radius>0.0176</radius><length>0.0055</length></cylinder></geometry></collision>
      <visual name="rear_left_duct">
        <visibility_flags>2</visibility_flags>
        <pose>-0.022981 0.022981 0.003 0 0 0</pose><geometry><mesh><uri>model://whoop/duct.obj</uri></mesh></geometry>
        <material><ambient>0.12 0.44 0.65 1</ambient><diffuse>0.12 0.44 0.65 1</diffuse></material>
      </visual>
      <visual name="rear_left_motor">
        <visibility_flags>2</visibility_flags>
        <pose>-0.022981 0.022981 0 0 0 0</pose><geometry><cylinder><radius>0.0035</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.12 0.13 0.15 1</ambient><diffuse>0.12 0.13 0.15 1</diffuse></material>
      </visual>
      <visual name="rear_left_arm">
        <visibility_flags>2</visibility_flags>
        <pose>-0.011491 0.011491 0 0 0 -0.785398</pose><geometry><box><size>0.0325 0.004 0.003</size></box></geometry>
        <material><ambient>0.12 0.44 0.65 1</ambient><diffuse>0.12 0.44 0.65 1</diffuse></material>
      </visual>
      <collision name="front_left_guard"><pose>0.022981 0.022981 0.003 0 0 0</pose><geometry><cylinder><radius>0.0176</radius><length>0.0055</length></cylinder></geometry></collision>
      <visual name="front_left_duct">
        <visibility_flags>2</visibility_flags>
        <pose>0.022981 0.022981 0.003 0 0 0</pose><geometry><mesh><uri>model://whoop/duct.obj</uri></mesh></geometry>
        <material><ambient>0.12 0.44 0.65 1</ambient><diffuse>0.12 0.44 0.65 1</diffuse></material>
      </visual>
      <visual name="front_left_motor">
        <visibility_flags>2</visibility_flags>
        <pose>0.022981 0.022981 0 0 0 0</pose><geometry><cylinder><radius>0.0035</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.12 0.13 0.15 1</ambient><diffuse>0.12 0.13 0.15 1</diffuse></material>
      </visual>
      <visual name="front_left_arm">
        <visibility_flags>2</visibility_flags>
        <pose>0.011491 0.011491 0 0 0 0.785398</pose><geometry><box><size>0.0325 0.004 0.003</size></box></geometry>
        <material><ambient>0.12 0.44 0.65 1</ambient><diffuse>0.12 0.44 0.65 1</diffuse></material>
      </visual>
    </link>
    <link name="rear_right">
      <pose>-0.022981 -0.022981 0.003 0 0 0</pose>
      <inertial><mass>0.00010</mass>
        <inertia><ixx>0.0000000065</ixx><iyy>0.0000000065</iyy><izz>0.000000012</izz></inertia>
      </inertial>
      <visual name="propeller">
        <visibility_flags>2</visibility_flags>
        <pose>0 0 0 0 0 0</pose><geometry><box><size>0.031 0.0032 0.001</size></box></geometry>
        <material><ambient>0.75 0.81 0.84 1</ambient><diffuse>0.75 0.81 0.84 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_right_shaft" type="revolute">
      <parent>body</parent><child>rear_right</child>
      <axis><xyz>0 0 1</xyz><limit><effort>0.003</effort><velocity>1000</velocity></limit></axis>
    </joint>
    <link name="front_right">
      <pose>0.022981 -0.022981 0.003 0 0 0</pose>
      <inertial><mass>0.00010</mass>
        <inertia><ixx>0.0000000065</ixx><iyy>0.0000000065</iyy><izz>0.000000012</izz></inertia>
      </inertial>
      <visual name="propeller">
        <visibility_flags>2</visibility_flags>
        <pose>0 0 0 0 0 0</pose><geometry><box><size>0.031 0.0032 0.001</size></box></geometry>
        <material><ambient>0.75 0.81 0.84 1</ambient><diffuse>0.75 0.81 0.84 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_right_shaft" type="revolute">
      <parent>body</parent><child>front_right</child>
      <axis><xyz>0 0 1</xyz><limit><effort>0.003</effort><velocity>1000</velocity></limit></axis>
    </joint>
    <link name="rear_left">
      <pose>-0.022981 0.022981 0.003 0 0 0</pose>
      <inertial><mass>0.00010</mass>
        <inertia><ixx>0.0000000065</ixx><iyy>0.0000000065</iyy><izz>0.000000012</izz></inertia>
      </inertial>
      <visual name="propeller">
        <visibility_flags>2</visibility_flags>
        <pose>0 0 0 0 0 0</pose><geometry><box><size>0.031 0.0032 0.001</size></box></geometry>
        <material><ambient>0.75 0.81 0.84 1</ambient><diffuse>0.75 0.81 0.84 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_left_shaft" type="revolute">
      <parent>body</parent><child>rear_left</child>
      <axis><xyz>0 0 1</xyz><limit><effort>0.003</effort><velocity>1000</velocity></limit></axis>
    </joint>
    <link name="front_left">
      <pose>0.022981 0.022981 0.003 0 0 0</pose>
      <inertial><mass>0.00010</mass>
        <inertia><ixx>0.0000000065</ixx><iyy>0.0000000065</iyy><izz>0.000000012</izz></inertia>
      </inertial>
      <visual name="propeller">
        <visibility_flags>2</visibility_flags>
        <pose>0 0 0 0 0 0</pose><geometry><box><size>0.031 0.0032 0.001</size></box></geometry>
        <material><ambient>0.75 0.81 0.84 1</ambient><diffuse>0.75 0.81 0.84 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_left_shaft" type="revolute">
      <parent>body</parent><child>front_left</child>
      <axis><xyz>0 0 1</xyz><limit><effort>0.003</effort><velocity>1000</velocity></limit></axis>
    </joint>
    <plugin filename="/usr/local/lib/libWhoopRotors.so" name="WhoopRotors">
      <thrust_coefficient>3.0e-7</thrust_coefficient>
      <torque_arm>0.003</torque_arm>
    </plugin>
    <!-- QUADX PWM packet order, props in, yaw_motors_reversed = OFF. -->
    <plugin filename="BetaflightPlugin" name="gz::sim::systems::BetaflightPlugin">
      <imuName>imu_sensor</imuName><connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <rotor id="0">
        <jointName>rear_right_shaft</jointName><turningDirection>ccw</turningDirection>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <vel_p_gain>0.000006</vel_p_gain><vel_i_gain>0</vel_i_gain><vel_d_gain>0</vel_d_gain>
        <vel_cmd_min>-0.003</vel_cmd_min><vel_cmd_max>0.003</vel_cmd_max>
      </rotor>
      <rotor id="1">
        <jointName>front_right_shaft</jointName><turningDirection>cw</turningDirection>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <vel_p_gain>0.000006</vel_p_gain><vel_i_gain>0</vel_i_gain><vel_d_gain>0</vel_d_gain>
        <vel_cmd_min>-0.003</vel_cmd_min><vel_cmd_max>0.003</vel_cmd_max>
      </rotor>
      <rotor id="2">
        <jointName>rear_left_shaft</jointName><turningDirection>cw</turningDirection>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <vel_p_gain>0.000006</vel_p_gain><vel_i_gain>0</vel_i_gain><vel_d_gain>0</vel_d_gain>
        <vel_cmd_min>-0.003</vel_cmd_min><vel_cmd_max>0.003</vel_cmd_max>
      </rotor>
      <rotor id="3">
        <jointName>front_left_shaft</jointName><turningDirection>ccw</turningDirection>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <vel_p_gain>0.000006</vel_p_gain><vel_i_gain>0</vel_i_gain><vel_d_gain>0</vel_d_gain>
        <vel_cmd_min>-0.003</vel_cmd_min><vel_cmd_max>0.003</vel_cmd_max>
      </rotor>
    </plugin>
  </model>
</sdf>
