+// Let the regular scheduler visit intermediate deadlines between two
+// Gazebo samples. Wall-clock jitter must not advance an RC or PID deadline.
+void sitlStepScheduler(void)
+{
+    if (!schedulerTimeUs) {
+        schedulerTimeUs = micros64();
+    }
+    while (sensorBudgetUs < 25) {
+        microsleep(50);
+    }
+    __atomic_fetch_sub(&sensorBudgetUs, 25, __ATOMIC_ACQ_REL);
+    schedulerTimeUs += 25;
+}
